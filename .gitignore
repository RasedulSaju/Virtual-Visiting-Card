# Dependencies
/vendor/

# Uploads (user content — never commit)
/uploads/profiles/*
!/uploads/profiles/default-avatar.png
!/uploads/profiles/.gitkeep
/uploads/pages/*
!/uploads/pages/.gitkeep

# Environment / secrets
config.php

# Logs & OS
*.log
.DS_Store
Thumbs.db

# MDB Pro (licensed / paid — never commit, upload manually per install)
/assets/mdb-pro/*.css
/assets/mdb-pro/*.js
/assets/mdb-pro/modules/*.css
/assets/mdb-pro/modules/*.js
!/assets/mdb-pro/.gitkeep
!/assets/mdb-pro/modules/.gitkeep

# NOTE: assets/mdb-free/ is intentionally NOT gitignored.
# It bundles the free, MIT-licensed MDB build directly in the repo so
# the site works out of the box with no CDN dependency and no manual
# setup step — see assets/mdb-free/LICENSE.txt.
